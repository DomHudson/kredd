FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ .
RUN npm run build:maintenance

FROM nginx:alpine
RUN apk add --no-cache certbot gettext

COPY --from=build /app/dist-maintenance/maintenance.html /usr/share/nginx/html/maintenance.html
COPY --from=build /app/dist-maintenance/assets/ /usr/share/nginx/html/maintenance-assets/assets/
COPY --from=build /app/public/favicon.png /usr/share/nginx/html/maintenance-assets/favicon.png

COPY nginx/nginx-ssl.public.conf /etc/nginx/nginx-ssl.public.conf
COPY nginx/nginx.public.conf /etc/nginx/conf.d/default.conf

COPY frontend/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
