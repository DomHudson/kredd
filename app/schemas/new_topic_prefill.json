{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["name", "description", "questions"],
  "properties": {
    "name": {"type": "string"},
    "description": {"type": "string"},
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "model_answer"],
        "properties": {
          "text": {"type": "string"},
          "model_answer": {"type": "string"}
        }
      }
    }
  }
}
